* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Development-only files stay in the public repository but are omitted from
# GitHub Release archives installed under STK_HOME.
/.github export-ignore
/.github/** export-ignore
/tests export-ignore
/tests/** export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.shellcheckrc export-ignore
/scripts/check.sh export-ignore
/scripts/preflight-update.sh export-ignore
/scripts/public-audit.sh export-ignore
