* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Source archives omit CI and test fixtures. Formal Nido release archives are
# built by the Go distribution helper and contain only the nido executable.
/.github export-ignore
/.github/** export-ignore
/tests export-ignore
/tests/** export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
