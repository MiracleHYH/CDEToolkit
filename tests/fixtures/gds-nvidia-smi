#!/usr/bin/env bash

set -euo pipefail

case " $* " in
  *' -L '*)
    printf '%s\n' 'GPU 0: Test GPU (UUID: GPU-test)'
    ;;
  *' --query-gpu=uuid '*)
    printf '%s\n' 'GPU-test'
    ;;
  *' --query-compute-apps='*)
    if [[ -r "${STK_TEST_GDS_WORK_DIR}/scheduler.pid" ]]; then
      read -r worker_pid <"${STK_TEST_GDS_WORK_DIR}/scheduler.pid"
      if [[ "${worker_pid}" =~ ^[1-9][0-9]*$ ]] && kill -0 "${worker_pid}" 2>/dev/null; then
        printf '%s\n' "${worker_pid}, GPU-test, scheduler, 1024"
      fi
    fi
    ;;
  *' --query-gpu='*)
    printf '%s\n' '0, Test GPU, 0, 0, 4096'
    ;;
  *)
    exit 2
    ;;
esac
