[Unit]
Description=Server Toolkit modules
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Environment=HOME=@HOME@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/service-start.sh start
ExecStop=@ROOT@/scripts/service-start.sh stop
RemainAfterExit=yes
TimeoutStartSec=90
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
